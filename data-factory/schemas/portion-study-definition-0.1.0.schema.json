{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nutrition-data-factory/portion-study-definition-0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "study_id",
    "status",
    "predecessor",
    "strategy_decision",
    "target",
    "measurement_protocol",
    "study_design_inputs",
    "future_observations",
    "estimates",
    "readiness",
    "publication"
  ],
  "properties": {
    "schema_version": {"const": "portion-study-definition-0.1.0"},
    "policy_version": {"const": "portion-study-definition-0.1.0"},
    "study_id": {"const": "vietnamese-com-trang-bat-study-definition-0.1.0"},
    "status": {"const": "study_design_incomplete"},
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "planning_packet"],
      "properties": {
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_ref", "schema_version", "sha256"],
          "properties": {
            "artifact_ref": {"const": "data-factory/config/portion-study-com-trang-bat-0.3.0.json"},
            "schema_version": {"const": "portion-study-manifest-0.3.0"},
            "sha256": {"const": "d9ca020236da68486645daaa0284dfce4d49b52b63b4a4f918b86810ef6a409e"}
          }
        },
        "planning_packet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_ref", "schema_version", "sha256"],
          "properties": {
            "artifact_ref": {"const": "data-factory/docs/reviews/vietnamese-com-trang-bat-portion-planning-0.1.0.json"},
            "schema_version": {"const": "portion-planning-packet-0.1.0"},
            "sha256": {"const": "5e645369733cff3423b803b239fca0bb9bbf91697d1afe065cb2a0461f25b351"}
          }
        }
      }
    },
    "strategy_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_ref",
        "schema_version",
        "sha256",
        "decision_reference",
        "decision",
        "strategy",
        "reviewer",
        "generalizable_to_all_vietnamese_bat",
        "decision_scope",
        "physical_study_definition_approved",
        "measurement_plan_values_approved",
        "gram_value_approved",
        "broader_household_study_requires_separate_decision"
      ],
      "properties": {
        "artifact_ref": {"const": "data-factory/docs/reviews/vietnamese-com-trang-bat-study-strategy-decision-0.1.0.json"},
        "schema_version": {"const": "portion-study-strategy-decision-0.1.0"},
        "sha256": {"const": "d6139ccd165db0682162dea6f43f6d0eccf021f4ea5a6a99ed5d5110f3202d43"},
        "decision_reference": {"const": "github:issue/53#issuecomment-5884079108"},
        "decision": {"const": "approved"},
        "strategy": {"const": "narrow_reproducible_pilot"},
        "reviewer": {"const": "pumni"},
        "generalizable_to_all_vietnamese_bat": {"const": false},
        "decision_scope": {"const": "study_strategy_only"},
        "physical_study_definition_approved": {"const": false},
        "measurement_plan_values_approved": {"const": false},
        "gram_value_approved": {"const": false},
        "broader_household_study_requires_separate_decision": {"const": true}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalized_vietnamese_target", "reviewed_evidence_identity", "backend_food_id", "preparation", "measure"],
      "properties": {
        "normalized_vietnamese_target": {"const": "cơm trắng"},
        "reviewed_evidence_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_ref", "schema_version", "sha256", "normalized_vietnamese_target", "decision_ref", "source", "specificity_policy_ref"],
          "properties": {
            "artifact_ref": {"const": "data-factory/docs/reviews/vietnamese-basic-food-identity-issue-35-reviewed-mapping-0.1.0.json"},
            "schema_version": {"const": "reviewed-food-mapping-0.1.0"},
            "sha256": {"const": "c7ab626ed66c01a84c6b00d7e312a3e061eef4af2ec4dcfed950e6b398307324"},
            "normalized_vietnamese_target": {"const": "cơm trắng"},
            "decision_ref": {"const": "github:issue/35#issuecomment-5882043136"},
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_code", "release", "fndds_food_code", "fdc_id", "source_record_sha256"],
              "properties": {
                "source_code": {"const": "usda_fndds"},
                "release": {"const": "2021-2023 / October 2024"},
                "fndds_food_code": {"const": "56205008"},
                "fdc_id": {"type": "integer", "const": 2708408},
                "source_record_sha256": {"const": "634cf6fabbcc9ccb76f513ef274a9dcc3d92f495c78792cf8221170d98a102cc"}
              }
            },
            "specificity_policy_ref": {"const": "resolve-exact-specificity-0.2.0"}
          }
        },
        "backend_food_id": {"type": "null"},
        "preparation": {"const": "Generic cooked white rice with no added fat, only when the user has not supplied a cultivar, variety, or materially different preparation. Cultivar distinction is not required for this generic evaluation identity."},
        "measure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["canonical_measure", "original_unit_phrase", "represented_quantity", "context_status", "physical_context"],
          "properties": {
            "canonical_measure": {"const": "bát"},
            "original_unit_phrase": {"const": "bát"},
            "represented_quantity": {"type": "integer", "const": 1},
            "context_status": {"const": "unresolved"},
            "physical_context": {"type": "null"}
          }
        }
      }
    },
    "measurement_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "estimator_version", "bound_policy_version"],
      "properties": {
        "protocol_version": {"const": "portion-measurement-0.1.0"},
        "estimator_version": {"const": "mean_of_sample_means-0.1.0"},
        "bound_policy_version": {"const": "minmax_of_sample_means-0.1.0"}
      }
    },
    "study_design_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vessel_definition",
        "vessel_context_sampling_rule",
        "serving_fill_protocol",
        "minimum_independent_sample_count",
        "minimum_independent_cooking_batch_count",
        "instrument_requirements",
        "calibration_check_requirements",
        "tare_method",
        "operator_requirements",
        "measurement_date_session_rules",
        "measurement_reviewer",
        "deviation_exclusion_policy"
      ],
      "properties": {
        "vessel_definition": {"$ref": "#/$defs/unresolved_input"},
        "vessel_context_sampling_rule": {"$ref": "#/$defs/unresolved_input"},
        "serving_fill_protocol": {"$ref": "#/$defs/unresolved_input"},
        "minimum_independent_sample_count": {"$ref": "#/$defs/unresolved_input"},
        "minimum_independent_cooking_batch_count": {"$ref": "#/$defs/unresolved_input"},
        "instrument_requirements": {"$ref": "#/$defs/unresolved_input"},
        "calibration_check_requirements": {"$ref": "#/$defs/unresolved_input"},
        "tare_method": {"$ref": "#/$defs/unresolved_input"},
        "operator_requirements": {"$ref": "#/$defs/unresolved_input"},
        "measurement_date_session_rules": {"$ref": "#/$defs/unresolved_input"},
        "measurement_reviewer": {"$ref": "#/$defs/unresolved_input"},
        "deviation_exclusion_policy": {"$ref": "#/$defs/unresolved_input"}
      }
    },
    "future_observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observation_count", "records"],
      "properties": {
        "status": {"const": "not_collected"},
        "observation_count": {"type": "integer", "const": 0},
        "records": {"type": "array", "maxItems": 0}
      }
    },
    "estimates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mass_estimate", "gram_estimate_emitted"],
      "properties": {
        "mass_estimate": {"type": "null"},
        "gram_estimate_emitted": {"const": false}
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ready_for_measurement", "review_ready", "blocker_count"],
      "properties": {
        "ready_for_measurement": {"const": false},
        "review_ready": {"const": false},
        "blocker_count": {"type": "integer", "const": 12}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "publishable", "production_eligible", "release_created", "activation_attempted"],
      "properties": {
        "status": {"const": "blocked"},
        "publishable": {"const": false},
        "production_eligible": {"const": false},
        "release_created": {"const": false},
        "activation_attempted": {"const": false}
      }
    }
  },
  "$defs": {
    "unresolved_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "reviewer", "review_ref"],
      "properties": {
        "status": {"const": "unresolved"},
        "value": {"type": "null"},
        "reviewer": {"type": "null"},
        "review_ref": {"type": "null"}
      }
    }
  }
}
