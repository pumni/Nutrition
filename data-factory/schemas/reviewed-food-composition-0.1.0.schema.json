        "properties": {
          "target_code": {"enum": ["energy_kcal", "protein_g", "carbohydrate_g", "fat_g"]},
          "fndds_nutrient_code": {"type": "string", "pattern": "^[0-9]{3}$"},
          "source_nutrient_id": {"type": "integer"},
          "source_label": {"type": "string", "minLength": 1},
          "source_unit": {"enum": ["kcal", "g"]},
          "source_amount": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"},
          "canonical_unit": {"enum": ["kcal", "g"]},
          "source_method": {"type": ["object", "null"]}
        },
        "oneOf": [
          {
            "properties": {
              "target_code": {"const": "energy_kcal"},
              "fndds_nutrient_code": {"const": "208"},
              "source_nutrient_id": {"enum": [1008, 2047]},
              "source_unit": {"const": "kcal"},
              "canonical_unit": {"const": "kcal"}
            }
          },
          {
            "properties": {
              "target_code": {"const": "protein_g"},
              "fndds_nutrient_code": {"const": "203"},
              "source_nutrient_id": {"const": 1003},
              "source_unit": {"const": "g"},
              "canonical_unit": {"const": "g"}
            }
          },
          {
            "properties": {
              "target_code": {"const": "carbohydrate_g"},
              "fndds_nutrient_code": {"const": "205"},
              "source_nutrient_id": {"const": 1005},
              "source_unit": {"const": "g"},
              "canonical_unit": {"const": "g"}
            }
          },
          {
            "properties": {
              "target_code": {"const": "fat_g"},
              "fndds_nutrient_code": {"const": "204"},
              "source_nutrient_id": {"const": 1004},
              "source_unit": {"const": "g"},
              "canonical_unit": {"const": "g"}
            }
          }
        ]
      }
    },
    "evaluation_eligible": {"const": true},
    "catalog_staging_authorized": {"const": false},
    "production_eligible": {"const": false},
    "activation_authorized": {"const": false},
    "portion_evidence_authorized": {"const": false},
    "recipe_evidence_authorized": {"const": false}
  }
}
