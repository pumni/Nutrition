    "source_code": {"const": "usda_fndds"},
    "source_release": {"const": "2021-2023 / October 2024"},
    "fndds_food_code": {"const": "56205008"},
    "fdc_id": {"const": 2708408},
    "source_description": {"const": "Rice, white, cooked, no added fat"},
    "source_record_sha256": {"const": "634cf6fabbcc9ccb76f513ef274a9dcc3d92f495c78792cf8221170d98a102cc"},
    "archive_filename": {"const": "FoodData_Central_survey_food_json_2024-10-31.zip"},
    "archive_sha256": {"const": "dfb06ae7ddc397ccd570b91c14b75438ab2ba39f64f22d321f61d4a52a77f3eb"},
