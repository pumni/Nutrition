    "fndds_adapter_version": {"const": "fndds-survey-json-0.1.0"},
    "nutrient_mapping_version": {"const": "fndds-required-nutrients-0.1.0"},
    "basis_amount": {"const": 100},
    "basis_unit": {"const": "g"},
    "edible_basis": {"const": true},
    "nutrients": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "allOf": [
        {"contains": {"properties": {"target_code": {"const": "energy_kcal"}}, "required": ["target_code"]}},
        {"contains": {"properties": {"target_code": {"const": "protein_g"}}, "required": ["target_code"]}},
        {"contains": {"properties": {"target_code": {"const": "carbohydrate_g"}}, "required": ["target_code"]}},
        {"contains": {"properties": {"target_code": {"const": "fat_g"}}, "required": ["target_code"]}}
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_code",
          "fndds_nutrient_code",
          "source_nutrient_id",
          "source_label",
          "source_unit",
          "source_amount",
          "canonical_unit"
