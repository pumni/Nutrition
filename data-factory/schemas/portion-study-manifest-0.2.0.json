{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nutrition-data-factory/portion-study-manifest-0.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "target",
    "study_plan",
    "protocol_version",
    "policy_version",
    "estimator_version",
    "bound_policy_version",
    "instrument",
    "tare",
    "operator_ids"
  ],
  "properties": {
    "schema_version": {"const": "portion-study-manifest-0.2.0"},
    "study_id": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "preparation", "measure"],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "food_concept_id", "reviewer", "review_ref"],
          "properties": {
            "status": {"enum": ["unresolved", "reviewed"]},
            "food_concept_id": {"type": ["string", "null"], "minLength": 1},
            "reviewer": {"type": ["string", "null"], "minLength": 1},
            "review_ref": {"type": ["string", "null"], "minLength": 1}
          },
          "allOf": [
            {
              "if": {"properties": {"status": {"const": "reviewed"}}},
              "then": {
                "properties": {
                  "food_concept_id": {"type": "string", "minLength": 1},
                  "reviewer": {"type": "string", "minLength": 1},
                  "review_ref": {"type": "string", "minLength": 1}
                }
              },
              "else": {
                "properties": {
                  "food_concept_id": {"type": "null"},
                  "reviewer": {"type": "null"},
                  "review_ref": {"type": "null"}
                }
              }
            }
          ]
        },
        "preparation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "definition", "reviewer", "review_ref"],
          "properties": {
            "status": {"enum": ["unresolved", "reviewed"]},
            "definition": {"type": ["string", "null"], "minLength": 1},
            "reviewer": {"type": ["string", "null"], "minLength": 1},
            "review_ref": {"type": ["string", "null"], "minLength": 1}
          },
          "allOf": [
            {
              "if": {"properties": {"status": {"const": "reviewed"}}},
              "then": {
                "properties": {
                  "definition": {"type": "string", "minLength": 1},
                  "reviewer": {"type": "string", "minLength": 1},
                  "review_ref": {"type": "string", "minLength": 1}
                }
              },
              "else": {
                "properties": {
                  "definition": {"type": "null"},
                  "reviewer": {"type": "null"},
                  "review_ref": {"type": "null"}
                }
              }
            }
          ]
        },
        "measure": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonical_measure",
            "original_unit_phrase",
            "represented_quantity",
            "context_status",
            "physical_context",
            "context_reviewer",
            "context_review_ref"
          ],
          "properties": {
            "canonical_measure": {"type": "string", "minLength": 1},
            "original_unit_phrase": {"type": "string", "minLength": 1},
            "represented_quantity": {"type": "number", "exclusiveMinimum": 0},
            "context_status": {"enum": ["unresolved", "reviewed"]},
            "physical_context": {"type": ["string", "null"], "minLength": 1},
            "context_reviewer": {"type": ["string", "null"], "minLength": 1},
            "context_review_ref": {"type": ["string", "null"], "minLength": 1}
          },
          "allOf": [
            {
              "if": {"properties": {"context_status": {"const": "reviewed"}}},
              "then": {
                "properties": {
                  "physical_context": {"type": "string", "minLength": 1},
                  "context_reviewer": {"type": "string", "minLength": 1},
                  "context_review_ref": {"type": "string", "minLength": 1}
                }
              },
              "else": {
                "properties": {
                  "physical_context": {"type": "null"},
                  "context_reviewer": {"type": "null"},
                  "context_review_ref": {"type": "null"}
                }
              }
            }
          ]
        }
      }
    },
    "study_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_independent_samples", "minimum_batches", "reviewer", "review_ref"],
      "properties": {
        "minimum_independent_samples": {"type": "integer", "minimum": 1},
        "minimum_batches": {"type": "integer", "minimum": 1},
        "reviewer": {"type": "string", "minLength": 1},
        "review_ref": {"type": "string", "minLength": 1}
      }
    },
    "protocol_version": {"const": "portion-measurement-0.1.0"},
    "policy_version": {"const": "portion-study-0.2.0"},
    "estimator_version": {"const": "mean_of_sample_means-0.1.0"},
    "bound_policy_version": {"const": "minmax_of_sample_means-0.1.0"},
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instrument_id", "resolution_g", "calibration"],
      "properties": {
        "instrument_id": {"type": "string", "minLength": 1},
        "resolution_g": {"type": "number", "exclusiveMinimum": 0},
        "calibration": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reference", "checked_at", "standard_mass_g", "observed_mass_g", "tolerance_g", "operator_id"],
          "properties": {
            "reference": {"type": "string", "minLength": 1},
            "checked_at": {"type": "string", "format": "date-time"},
            "standard_mass_g": {"type": "number", "exclusiveMinimum": 0},
            "observed_mass_g": {"type": "number", "exclusiveMinimum": 0},
            "tolerance_g": {"type": "number", "minimum": 0},
            "operator_id": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "tare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "mass_g"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "mass_g": {"type": "number", "minimum": 0}
      }
    },
    "operator_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
