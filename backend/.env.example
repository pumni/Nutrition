APP_ENV=local
APP_BIND_ADDR=127.0.0.1:8080
RUST_LOG=info

DATABASE_URL=postgres://nutrition:nutrition@127.0.0.1:5432/nutrition

AUTH_MODE=development
PARSER_MODE=fixture

# Hosted parser settings are server-side and remain subject to staging/production approval gates.
# Uncomment only when hosted parsing is explicitly approved for the target environment.
# PARSER_MODE=hosted
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-5.6-luna
# LLM_ENDPOINT=https://api.openai.com/v1/responses
# LLM_API_KEY=
# LLM_MAX_IN_FLIGHT=1

RUN_MIGRATIONS=false
RUN_FOUNDATION_SEED=false
RUN_FDC_FOUNDATION_IMPORT=false
WORKER_MODE=idle
WORKER_ID=worker-local
WORKER_DATABASE_POOL_SIZE=4
WORKER_BATCH_SIZE=20
WORKER_POLL_INTERVAL_MS=500
