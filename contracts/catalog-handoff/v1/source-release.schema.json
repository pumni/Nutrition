{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumni.example/contracts/catalog-handoff/v1/source-release.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["source_code", "release", "publisher", "purpose", "locator", "rights_state", "production_eligible", "archive_artifact", "extracted_artifact"],
  "properties": {
    "source_code": {"const": "usda_fdc"}, "release": {"const": "2026-04-30"}, "publisher": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1},
    "locator": {"type": "string", "minLength": 1}, "rights_state": {"type": "string", "minLength": 1}, "production_eligible": {"const": false},
    "archive_artifact": {"$ref": "#/$defs/artifact"}, "extracted_artifact": {"$ref": "#/$defs/artifact"}
  },
  "$defs": {"artifact": {"type": "object", "additionalProperties": false, "required": ["sha256", "size", "content_type", "relative_path"], "properties": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size": {"type": "integer", "minimum": 0}, "content_type": {"type": "string", "minLength": 1}, "relative_path": {"type": "string", "minLength": 1}, "acquisition": {"type": "object", "additionalProperties": false, "required": ["source_code", "publisher", "release", "retrieved_at", "filename", "size", "content_type", "sha256", "rights_state", "acquisition_tool_version"], "properties": {"source_code": {"type": "string", "minLength": 1}, "publisher": {"type": "string", "minLength": 1}, "release": {"type": "string", "minLength": 1}, "retrieved_at": {"type": "string", "minLength": 1}, "filename": {"type": "string", "minLength": 1}, "size": {"type": "integer", "minimum": 0}, "content_type": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "rights_state": {"type": "string", "minLength": 1}, "acquisition_tool_version": {"type": "string", "minLength": 1}}}}}}
}
