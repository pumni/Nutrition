{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pumni.example/contracts/catalog-handoff/v1/dataset-release.schema.json",
  "type": "object", "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"dataset_code": {"const": "usda_fdc_foundation"}}}, "then": {"properties": {"version": {"const": "2026-04-30"}, "source_rights_state": {"const": "approved"}}}},
    {"if": {"properties": {"dataset_code": {"const": "synthetic_fixture"}}}, "then": {"properties": {"version": {"const": "0.1.0"}, "source_rights_state": {"const": "test_only"}}}}
  ],
  "required": ["dataset_code", "version", "status", "artifact_sha256", "archive_sha256", "schema_fingerprint", "source_rights_state", "record_count", "production_eligible"],
  "properties": {
    "dataset_code": {"enum": ["usda_fdc_foundation", "synthetic_fixture"]}, "version": {"type": "string", "minLength": 1}, "status": {"const": "staged_candidate"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "archive_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "object_uri": {"type": "string", "minLength": 1}, "schema_fingerprint": {"type": "string", "minLength": 1},
    "source_rights_state": {"enum": ["approved", "test_only", "reference_only", "prohibited"]}, "record_count": {"type": "integer", "const": 20}, "production_eligible": {"const": false}
  }
}
